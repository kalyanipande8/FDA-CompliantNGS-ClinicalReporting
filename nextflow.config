/*
 * nextflow.config -- authored for AWS HealthOmics private-workflow
 * packaging conventions. NOT deployed/run on real AWS in this
 * environment (see README.md and main.nf header for full disclosure).
 *
 * AWS HealthOmics private workflows (as documented by AWS) require:
 *   - Nextflow DSL2, one container image per process, referenced by full
 *     ECR URI (no docker.io/quay.io pulls at run time inside HealthOmics --
 *     images must be mirrored into a private ECR repo first; the
 *     quay.io references in main.nf are left as-authored/documented
 *     upstream sources and would be re-tagged into ECR as part of a real
 *     deployment, per AWS's "Create a container image" workflow docs)
 *   - no local `docker`/`singularity` engine directives; HealthOmics
 *     manages the runtime itself
 *   - a workflow definition zip containing main.nf, nextflow.config, and
 *     any modules, plus a parameter-template.json describing accepted
 *     `params.*` inputs for the HealthOmics console/API
 *   - inputs/outputs addressed as s3:// URIs at run time (HealthOmics
 *     stages them into/out of the run's isolated storage)
 *   - resource requests (cpus/memory) per process, which HealthOmics maps
 *     onto its own instance-selection logic
 */

manifest {
    name            = 'fda-compliant-ngs-clinical-reporting'
    description     = 'Tumor/normal NGS secondary analysis, panel annotation, and AMP/ASCO/CAP clinical tiering'
    author          = 'Kalyani Pande'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}

params {
    samples_manifest = "data/samples_manifest.tsv"
    reads_dir        = "data/reads"
    reference        = "data/reference/synthetic_reference.fasta"
    gene_model       = "data/reference/gene_model.tsv"
    outdir           = "results"
}

// Local profile: used only for authoring/syntax review with a local
// Nextflow + container engine (never actually invoked in this build
// environment, which has neither Nextflow nor Docker installed -- see
// README). Kept here because it is the documented default entry point
// for `nextflow run main.nf` before targeting HealthOmics.
profiles {
    standard {
        process.executor = 'local'
        docker.enabled   = true
    }

    // Modeled on AWS HealthOmics' documented private-workflow run
    // requirements: no local executor/container-engine directives here,
    // because HealthOmics itself supplies the execution environment and
    // container runtime for a submitted workflow run. This profile
    // exists to document that intent; it was never used to submit a real
    // HealthOmics run (no AWS account/credentials in this environment).
    healthomics {
        process {
            // HealthOmics maps these onto its own instance-selection
            // logic; explicit per-process values are set in main.nf.
            executor = 'awsbatch'
        }
        aws {
            region = 'us-east-1' // placeholder; never used against a real account
        }
    }
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_trace.txt"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}
